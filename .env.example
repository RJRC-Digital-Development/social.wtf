# ==============================================================================
# SOCIAL.WTF ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cryptographic Session Secret
# ------------------------------------------------------------------------------
# Minimum 32 characters. Used for HMAC-SHA256 session token signatures and adult auth grants.
SESSION_SECRET=your_secure_random_session_secret_key_minimum_32_characters_long

# ------------------------------------------------------------------------------
# 2. Cookie Chain Network RPC
# ------------------------------------------------------------------------------
# Cookie Chain SVM RPC URL for balance checking and transaction broadcasts.
NEXT_PUBLIC_COOKIE_RPC=https://rpc.cookiescan.io

# ------------------------------------------------------------------------------
# 3. Cookie Chain On-Chain Signer Private Key
# ------------------------------------------------------------------------------
# Configure this private key to complete and broadcast on-chain transactions
# (tips, creator storefront purchases, treasury fee splits) on Cookie Chain.
# Supported Formats:
#   - Base58 encoded string (standard export from Trust Wallet, Phantom, Solflare)
#   - JSON byte array: [12, 34, 56, ... 78] (standard Solana CLI id.json format)
#   - 64-byte or 32-byte Hex string
PLATFORM_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Optional: Platform Owner Wallet Public Key
# ------------------------------------------------------------------------------
# Base58 public key of the platform owner. When authenticated via SIWS, grants 'admin' scope.
# If omitted, no admin sessions are issued (fail-closed).
PLATFORM_OWNER_WALLET=

# ------------------------------------------------------------------------------
# 5. Optional: Distributed Key-Value Store (Upstash Redis / Vercel KV)
# ------------------------------------------------------------------------------
# If omitted, social.wtf falls back automatically to high-speed in-memory rate limiting and storage.
# UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
